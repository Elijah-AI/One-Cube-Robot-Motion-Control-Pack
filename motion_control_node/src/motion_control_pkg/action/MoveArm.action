std_msgs/Header header                     
string task_id                             
uint8 arm_id              
bool use_planning        
bool enable_collision_check 
geometry_msgs/PoseStamped target_pose
float32[] safety_distance
#bool use_obstacle_avoidance
sensor_msgs/PointCloud2 env_point_cloud    
string point_cloud_frame_id               
---
bool success
string error_message        
float64 execution_time      
float64 final_distance_error 
---
string task_status                  
float32 progress_rate                 
string current_step_info              
std_msgs/Header header                
