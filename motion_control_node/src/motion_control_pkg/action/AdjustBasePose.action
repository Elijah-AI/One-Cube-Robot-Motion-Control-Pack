std_msgs/Header header                     
string task_id                             
float32 head_pitch_delta    
float32 head_yaw_delta    
float32 lift_height_delta 
float32 base_pitch_delta    
bool relative_mode        
---
bool success
string error_message
float64 execution_time
float32 final_head_pitch
float32 final_head_yaw
float32 final_lift_height
float32 final_base_pitch
---
float32 percent_complete
float32 current_head_pitch
float32 current_lift_height
string status_text         
