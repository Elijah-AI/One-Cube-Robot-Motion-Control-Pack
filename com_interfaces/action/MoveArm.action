std_msgs/Header header
string task_id
string arm_id                               # 机械臂ID: "0"=左臂, "1"=右臂, "2"=双臂, "3"=头部, "4"=折叠推杆
bool enable_collision_check
geometry_msgs/PoseStamped target_pose
float32[] bound_size                       # 包围盒尺寸: [x, y, z]
bool use_force_control                     # 力控模式
uint8[] hand_action_type                   # 灵巧手动作类型
sensor_msgs/PointCloud2 env_point_cloud
string point_cloud_frame_id
int64 timeout_ms                           # 超时时间, 默认5000ms
---
bool success
string error_message
float64 execution_time
float64 final_distance_error
---
string task_status                         # 任务状态: "0"=等待中, "1"=执行中
float32 progress_rate                      # 进度百分比: 0.0 ~ 100.0
string current_step_info
std_msgs/Header header
