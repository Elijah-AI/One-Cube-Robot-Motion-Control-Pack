std_msgs/Header header                     
string task_id                             
uint8 arm_id                     
bool enable_collision_check 
geometry_msgs/PoseStamped target_pose    #目标物体6D位姿，或者身体部件（折叠腿）位姿
float32[] bound_size                     #目标物体包络尺寸
bool use_force_control                   #开启力控
float32 speed                               #控制速度，0～1
uint8[] hand_action_type                 #灵巧手动作类型，可选，未装则不用
sensor_msgs/PointCloud2 env_point_cloud    
string point_cloud_frame_id
int64 timeout_ms                         #操作超时时间毫秒，默认5000ms               
---
bool success
string error_message        
float64 execution_time      
float64 final_distance_error 
---
string task_status                  
float32 progress_rate                 
string current_step_info              
std_msgs/Header header                
