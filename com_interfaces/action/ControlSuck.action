# Goal
# 吸盘编号仅预留接口；GPIO 驱动和状态回读本阶段不实现。
uint8 SUCK_LEFT=0
uint8 SUCK_RIGHT=1
uint8 SUCK_BOTH=2

std_msgs/Header header
string task_id
uint8 suck_id        #0：左吸盘，1：右吸盘，2：双吸盘
bool[] active        #打开/关闭
int64 timeout_ms

---
# Result
bool success
string error_message

---
# Feedback
std_msgs/Header header
float32 progress_rate
