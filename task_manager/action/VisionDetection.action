std_msgs/Header header                     # 时间戳
string task_id                             # 唯一任务标识符，用于后续查询或取消
string target_obj_name                     # 待检测目标物的名称
string expected_frame_id                   # 可选期望视觉节点输出的6D位姿的坐标系ID，"camera_link"：
                                           # 基于相机自己的坐标系，"base_link"：基于基坐标系。暂时预留
bool need_6d_pose                          # 是否需要目标物6D位姿（true=必须返回）
bool need_env_point_cloud                  # 是否需要环境点云（true=必须返回）
float32 point_cloud_downsample_resolution  # 点云下采样分辨率（米，默认0.05）
int32 priority                             # 任务优先级 (1-25, 25最高)，用于任务队列排序
int8  type                                 # 任务类型。0：检测目标物， 1：检测目标物放置
---
bool success                               # 任务是否成功（true=成功获取数据）
std_msgs/Header header                     # 结束时的时间戳
uint8 status_code                          # 详细状态码: 
                                           # 0: OK
                                           # 1: FAILED (硬件故障)
                                           # 2: TIMEOUT (超时未响应)
                                           # 3: BUSY (正在执行其他高优先级任务)
string error_message                       # 详细错误描述 (e.g., "Goal blocked by dynamic obstacle")
float64 execution_time                     # 总耗时 (秒)
# 核心返回数据：目标物6D位姿
geometry_msgs/PoseStamped target_6d_pose   # 6D位姿（3D位置+3D姿态，带时间戳）
float32 pose_confidence                    # 可选 位姿估计置信度≥0.8：高可靠，直接用于运控规划
                                           #0.6~0.8：偏低，建议二次复核检测
                                           #＜0.6：可信度不足，放弃当前位姿

# 核心返回数据：环境点云
sensor_msgs/PointCloud2 env_point_cloud    # 滤波后的环境点云数据
string point_cloud_frame_id                # 可选 点云坐标系（如：camera_link/base_link）

---
string task_status                         # 任务状态：DETECTING/ESTIMATING_POSE/GENERATING_CLOUD/FINISHED
float32 progress_rate                      # 任务完成进度（0~100%）
string current_step_info                   # 当前执行步骤描述（如：正在检测目标物/正在估计6D位姿）
std_msgs/Header header                     # 时间戳