std_msgs/Header header                     # 时间戳。       
string task_id                             # 唯一任务标识符，用于后续查询或取消。
uint8 gripper_id                           # 机械臂编号0：左爪，1：右爪，2：双爪。
uint8[2] position                          # 目标点位
uint8[2] speed                             # 目标速度
uint8[2] max_torque                        # 限定扭矩
bool block_until_complete                  # 可选 是否阻塞
int64 timeout_ms                           # 执行超时 
---
bool success                               # 执行结果
uint8[2] final_position                    # 最终位置
uint8[2] final_torque                      # 最终扭矩
string error_message                       # 异常信息
---
uint8[2] current_position                  # 当前位置
uint8[2] current_torque                    # 当前扭矩
uint8[2] current_speed                     # 当前速度
float32 progress_rate                      # 当前进度
std_msgs/Header header                     # 时间戳