std_msgs/Header header                     # 时间戳。
string task_id                             # 唯一任务标识符，用于后续查询或取消。
string arm_id                              # 机械臂编号0：左臂，1：右臂，2：双臂。
bool use_planning                          # 是否使用规划。
bool enable_collision_check                # 是否启用碰撞检测。
geometry_msgs/PoseStamped target_pose      # 目标物品的6D位姿。
float32[] safety_distance                  # 距离目标位姿的安全距离x,y,z。
sensor_msgs/PointCloud2 env_point_cloud    # 点云数据。
string point_cloud_frame_id                # 可选，点云数据的参考坐标系。
---
bool success                               # 是否成功
string error_message                       # 失败信息
float64 execution_time                     # 可选，执行时长
float64 final_distance_error               # 可选，最终偏差
---
string task_status                         # 任务状态。0：等待中，1：执行中
float32 progress_rate                      # 进度值0.0~100.0
string current_step_info                   # 当前执行步骤
std_msgs/Header header                     # 时间戳