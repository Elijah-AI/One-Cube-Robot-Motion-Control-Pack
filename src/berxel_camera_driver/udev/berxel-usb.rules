# -----------------------------------------------------------------------------
# Disable USB autosuspend for the two pipes of the dual-USB Berxel Hawk cameras
# (e.g. iHawk100RS exposes VID3558:PID1012 as the "master" pipe and
# VID0603:PID001f as the "depth/ISP" pipe).  If the kernel suspends a pipe while
# the SDK is streaming, the device may drop off the bus (node then reports
# "Hotplug device ... LEFT" and later re-ARRIVEs as a NEW device number, so no
# frames ever reach the node).  ATTR{power/control}="on" keeps the link alive;
# this is the same mitigation shipped by other 3D-camera vendors (e.g. RealSense).
# See kernel doc Documentation/driver-api/usb/power-management.rst.
# -----------------------------------------------------------------------------
SUBSYSTEM=="usb", ATTR{idProduct}=="1012", ATTR{idVendor}=="3558", ATTR{power/control}="on"
SUBSYSTEM=="usb", ATTR{idProduct}=="001f", ATTR{idVendor}=="0603", ATTR{power/control}="on"
