# 0 左，1 右。每次请求只操作一条总线。
uint8 side
# 0x6E 有符号 PWM，-1000 至 1000。0 请求制动停止。
int16 pwm
# 0 持续输出直到新指令或停止。正值从交给传输层起计时，单位毫秒。
uint32 duration_ms
---
bool success
# 非零请求对应原运动帧。零请求在电机模式下对应零输出帧。
bool sent
# true 表示收到了成功短应答。固件明确拒绝时 sent 仍为 true，原因见 message。
bool acknowledged
# 制动开关、零 PWM 和静止反馈已读回。
bool stop_confirmed
string message
