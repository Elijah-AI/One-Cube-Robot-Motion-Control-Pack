prefix=/home/quicktron/quicktron/lidar_driver/src/laser_r2000_driver/pepperl_fuchs_r2000/third_party/gflags-2.2.1/build
exec_prefix=${prefix}
bindir=${prefix}/bin
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gflags
Version: 2.2.1
Description: A commandline flags library that allows for distributed flags.
URL: http://gflags.github.io/gflags
Requires:
Libs: -L${libdir} -lgflags
Libs.private: -lpthread 
Cflags: -I${includedir}
