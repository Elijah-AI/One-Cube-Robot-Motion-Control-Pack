<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motion_control_pkg</name>
  <version>0.0.0</version>
  <description>Stage 0-7 Marvin dual-arm motion control with deferred head, lower-body, and tool routes.</description>
  <maintainer email="robot@todo.todo">robot</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 运行时和编译时依赖 -->
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp_action</depend>
  <depend>com_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2action</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend>

  <depend>eigen</depend>
  <depend>urdfdom</depend>
  <depend>libfcl-dev</depend>
  <depend>libccd-dev</depend>
  <depend>liboctomap-dev</depend>
  <depend>ompl</depend>
  <depend>pinocchio</depend>
  <depend>coal</depend>
  <depend>ruckig</depend>
  <depend>libjsoncpp-dev</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>onecube_robot_description</exec_depend>
  <test_depend>python3-numpy</test_depend>
  <test_depend>tf2_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
